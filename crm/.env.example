DATABASE_URL=postgresql://etc:etc@localhost:5433/etc
APP_URL=http://localhost:3000
BUSINESS_SLUG=etc
# Comma-separated owner emails allowed to sign in (seeded as users)
OWNER_EMAILS=owner@example.com
# Comma-separated addresses copied on new-booking notices (no sign-in link for non-owners)
OWNER_CC=
# Origins allowed to POST bookings cross-origin
PUBLIC_SITE_ORIGINS=http://localhost:8768,https://etccrew.ca
MEDIA_SIGNING_SECRET=change-me-to-32-random-bytes
UPLOAD_DIR=./data/uploads
# Mail (same values as the Python site). Mailpit locally:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=etc. <bookings@etccrew.ca>
HELP_EMAIL=help@etccrew.ca
ETRANSFER_EMAIL=pay@etccrew.ca
SITE_URL=https://etccrew.ca
WEATHER_USER_AGENT=etc-crm/1.0 help@etccrew.ca
# Set to 1 to stop the in-process scheduler (tests)
CRON_DISABLED=
# Optional: card payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Interac e-Transfer auto-match (shared with the Cloudflare Email Worker)
INTERAC_INBOUND_SECRET=
