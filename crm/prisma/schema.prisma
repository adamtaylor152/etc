// etc. CRM schema. Money is integer cents, snow depth integer cm.
// Calendar dates are @db.Date (handled as YYYY-MM-DD in America/Edmonton); instants are timestamptz.
// Every tenant table carries businessId (SaaS insurance); scope every query by it (see src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------
enum UserRole {
  OWNER
  CREW
}

enum TokenPurpose {
  LOGIN
  OWNER_DEEP_LINK
  QUOTE
  INVOICE
  CLIENT_HUB
  PHOTO_UPLOAD
  VISIT_REPORT
  REVIEW
  VISIT_CONFIRM
  PRICE_CHANGE
}

// Driveway size: sets the snow price (standard = 1-2 car). Oversized gets a quote.
enum DriveSize {
  STANDARD
  LARGE
  OVERSIZED
}

enum ClientSource {
  BOOKING_FORM
  MANUAL
  PHONE
  REFERRAL
  CLIENT_HUB
  IMPORT
}

enum PaymentMethod {
  CASH
  ETRANSFER
  CARD
  CHEQUE
  OTHER
}

enum GeocodeSource {
  PLACES_AUTOCOMPLETE
  GOOGLE_GEOCODING
  MANUAL_PIN
  NONE
}

enum ServiceCategory {
  SNOW
  CLEANUP
  WASHING
  FIXUP
  ADDON
  OTHER
}

enum PricingMode {
  FIXED
  QUOTE
}

enum PriceUnit {
  EACH
  VISIT
  PUSH
  HOUR
  SEASON
}

enum RequestStatus {
  NEW
  ASSESSMENT_SCHEDULED
  CONVERTED
  ARCHIVED
}

enum SnowPlanChoice {
  ONE_TIME
  EVERY_SNOWFALL
}

enum QuoteStatus {
  DRAFT
  AWAITING_RESPONSE
  CHANGES_REQUESTED
  APPROVED
  CONVERTED
  ARCHIVED
  DECLINED
}

enum JobKind {
  ONE_OFF
  RECURRING
  SNOW_PLAN
}

enum BillingType {
  FIXED_PRICE
  PER_VISIT
}

enum InvoiceSchedule {
  AFTER_EACH_VISIT
  PER_SNOW_EVENT
  MONTHLY
  ON_COMPLETION
  MANUAL
}

enum SnowBillingMode {
  PER_PUSH
  PER_EVENT
  SEASONAL
}

enum VisitState {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum VisitSource {
  MANUAL
  BOOKING
  RECURRENCE
  SNOW_EVENT
}

enum SkipReason {
  ALREADY_CLEARED
  BLOCKED_BY_CAR
  NO_ACCESS
  BELOW_TRIGGER
  CLIENT_CANCELLED
  WEATHER
  OTHER
}

enum SnowEventStatus {
  FORECAST
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  BAD_DEBT
  VOID
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_7
  NET_15
  NET_30
}

enum PaymentStatus {
  SUCCEEDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AttachmentKind {
  BEFORE
  AFTER
  REQUEST_PHOTO
  PROOF
  DOCUMENT
  OTHER
  TEXT_PHOTO // came in (or went out) by MMS
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  FILE
}

enum ActorType {
  USER
  CLIENT
  SYSTEM
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum CounterKind {
  REQUEST
  QUOTE
  JOB
  INVOICE
  SNOW_EVENT
}

// ---------- tenancy & auth ----------
model Business {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  legalName           String?
  email               String?
  phone               String?
  helpEmail           String?
  etransferEmail      String?
  mailingAddress      String? // required in marketing emails (CASL)
  website             String?
  timezone            String       @default("America/Edmonton")
  currency            String       @default("CAD")
  taxRegistered       Boolean      @default(false)
  taxName             String       @default("GST")
  taxRateBps          Int          @default(500)
  taxNumber           String?
  pricesIncludeTax    Boolean      @default(true)
  defaultPaymentTerms PaymentTerms @default(DUE_ON_RECEIPT)
  depotAddress        String?
  depotLat            Float?
  depotLng            Float?
  googleReviewUrl     String?
  settings            Json         @default("{}")
  createdAt           DateTime     @default(now())

  users    User[]
  clients  Client[]
  services Service[]
}

model User {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  email       String
  name        String?
  phone       String?
  color       String    @default("#1d6fd8") // their colour on the schedule
  hourlyCostCents Int   @default(0) // what an hour of their time costs (job profit)
  workHours   Json      @default("{\"1\":[\"08:00\",\"18:00\"],\"2\":[\"08:00\",\"18:00\"],\"3\":[\"08:00\",\"18:00\"],\"4\":[\"08:00\",\"18:00\"],\"5\":[\"08:00\",\"18:00\"],\"6\":[\"08:00\",\"16:00\"]}") // weekday (0=Sun) -> [start, end]; missing = off
  role        UserRole  @default(OWNER)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  // Where their route starts and ends (null = the business depot)
  startAddress String?
  startLat    Float?
  startLng    Float?
  endAddress  String?
  endLat      Float?
  endLng      Float?
  createdAt   DateTime  @default(now())
  sessions    Session[]
  visitAssignments VisitAssignee[]
  taskAssignments  TaskAssignee[]
  timeEntries      TimeEntry[]

  @@unique([businessId, email])
}

model Session {
  id         String   @id // sha256 of the cookie value
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model LinkToken {
  id           String       @id @default(cuid())
  businessId   String
  purpose      TokenPurpose
  tokenHash    String       @unique // sha256(raw); raw value is never stored
  userId       String?
  clientId     String?
  requestId    String?
  quoteId      String?
  invoiceId    String?
  jobId        String?
  visitId      String?
  redirectPath String?
  expiresAt    DateTime
  maxUses      Int?
  useCount     Int          @default(0)
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([businessId, purpose])
}

// ---------- clients & places ----------
model Client {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id])
  firstName        String
  lastName         String         @default("")
  companyName      String?
  email            String // lowercased
  altEmails        String[]
  phone            String?
  title            String? // Mr., Ms., Dr. ...
  leadSource       String? // how they found us (Google, referral, door hanger...)
  phones           Json           @default("[]") // [{number,label,sms}]; phone above mirrors the first
  emails           Json           @default("[]") // [{address,label}]; email above mirrors the first
  emailMarketingConsentAt     DateTime? // express consent to marketing email (CASL)
  emailMarketingConsentSource String? // booking form, verbal, hub...
  referralCode     String? // their share code (etccrew.ca/book.html?ref=CODE)
  referredById     String? // the client who referred them
  followUpQuotes   Boolean        @default(true)
  followUpInvoices Boolean        @default(true)
  visitReminders   Boolean        @default(true)
  preferredPayment PaymentMethod?
  source           ClientSource
  referredBy       String?
  tags             String[]
  notes            String?
  marketingOptOut  Boolean        @default(false)
  smsOptIn         Boolean        @default(false) // client agreed to automatic text updates
  smsOptOutAt      DateTime? // client texted STOP: no texts at all until they text START
  emailBouncedAt   DateTime?
  doNotService     Boolean        @default(false) // flagged: shows a warning wherever work is booked for them
  // Card on file: Stripe ids and display data only, never a card number.
  stripeCustomerId     String?
  cardPaymentMethodId  String?
  cardBrand            String?
  cardLast4            String?
  cardExpMonth         Int?
  cardExpYear          Int?
  cardSavedAt          DateTime?
  autoPayConsentAt     DateTime? // the client chose "charge this card automatically for my invoices"; null = off
  autoPayConsentSource String? // where they chose it: "hub" or "invoice"
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  properties  Property[]
  requests    Request[]
  jobs        Job[]
  quotes      Quote[]
  invoices    Invoice[]
  payments    Payment[]
  attachments Attachment[]
  notesList   Note[]
  texts       TextMessage[]
  contacts    ClientContact[]
  calls       CallLog[]

  @@index([businessId, email])
}

model Property {
  id            String        @id @default(cuid())
  businessId    String
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  label         String?
  formatted     String // the address as typed/selected
  normalized    String // lowercased, collapsed whitespace: dedupe key
  line1         String?
  postalCode    String?
  city          String        @default("Calgary")
  province      String        @default("AB")
  placeId       String?
  steps         Int? // site facts the crew and quotes care about
  sidewalkM     Int? // metres of sidewalk to clear
  lawnSqM       Int? // lawn area, square metres
  lat           Float?
  lng           Float?
  geocodeSource GeocodeSource @default(NONE)
  communityCode String?
  community     Community?    @relation(fields: [communityCode], references: [code])
  accessNotes   String?
  gateCode      String?
  petNotes      String?
  hazards       String?
  routeSort     Int?
  routePriority Boolean       @default(false) // "do first" in its community (seniors, medical, early commuters)
  driveSize     DriveSize? // what the client picked, until someone checks it
  extraWalk     Boolean       @default(false) // corner lot / long public sidewalk
  sizeCheckedAt DateTime? // null = nobody has looked at the satellite view yet
  isDefault     Boolean       @default(false)
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())

  requests    Request[]
  jobs        Job[]
  visits      Visit[]
  quotes      Quote[]
  attachments Attachment[]

  @@index([businessId, normalized])
  @@index([businessId, communityCode])
}

// Global reference data (City of Calgary Community District Boundaries)
model Community {
  code        String   @id
  name        String
  sector      String?
  class       String?
  geometry    Json
  centroidLat Float
  centroidLng Float
  sourceDate  String

  properties Property[]
  service    ServiceCommunity[]
}

model ServiceCommunity {
  businessId    String
  communityCode String
  community     Community @relation(fields: [communityCode], references: [code])
  sortOrder     Int       @default(0)
  color         String?
  active        Boolean   @default(true)

  @@id([businessId, communityCode])
}

// ---------- price book ----------
model Service {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  key            String
  name           String
  bookingLabel   String? // exact value posted by book.html, e.g. "Snow shovelling"
  category       ServiceCategory
  description    String?
  pricingMode    PricingMode
  unitPriceCents Int?
  unit           PriceUnit       @default(EACH)
  isAddon        Boolean         @default(false)
  checklistTemplateId String? // jobs with this service get this checklist
  bookable       Boolean         @default(true)
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  defaultDurationMin Int? // stored + shown only for now (scheduling later)
  unitCostCents  Int? // what it costs us per unit (job profit later)
  taxExempt      Boolean         @default(false) // stored only; invoice totals don't read it yet

  @@unique([businessId, key])
}

// ---------- pipeline ----------
model Request {
  id               String          @id @default(cuid())
  businessId       String
  number           Int
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  propertyId       String?
  property         Property?       @relation(fields: [propertyId], references: [id])
  source           ClientSource
  status           RequestStatus   @default(NEW)
  title            String
  services         String[] // booking labels as submitted
  snowPlan         SnowPlanChoice?
  iceMelt          Boolean         @default(false)
  preferredDate    DateTime?       @db.Date
  preferredPayment PaymentMethod?
  notes            String?
  accessNotes      String?
  estimateText     String? // exact legacy string, e.g. "$35 / snowfall + quote"
  rawPayload       Json?
  ip               String?
  userAgent        String?
  legacyBookingId  Int?
  assessmentAt     DateTime?
  convertedAt      DateTime?
  archivedAt       DateTime?
  lostReason       String? // why it didn't go ahead (asked when archiving)
  createdAt        DateTime        @default(now())

  jobs        Job[]
  quotes      Quote[]
  attachments Attachment[]

  @@unique([businessId, number])
  @@unique([businessId, legacyBookingId])
  @@index([businessId, status])
}

model Quote {
  id                   String      @id @default(cuid())
  businessId           String
  number               Int
  clientId             String
  client               Client      @relation(fields: [clientId], references: [id])
  propertyId           String?
  property             Property?   @relation(fields: [propertyId], references: [id])
  requestId            String?
  request              Request?    @relation(fields: [requestId], references: [id])
  status               QuoteStatus @default(DRAFT)
  title                String?
  message              String?
  subtotalCents        Int         @default(0)
  discountCents        Int         @default(0) // computed dollars off (what every reader uses)
  discountType         String      @default("FIXED") // FIXED | PERCENT
  discountValue        Int         @default(0) // cents, or percent x100 (1250 = 12.5%)
  taxCents             Int         @default(0)
  totalCents           Int         @default(0)
  validUntil           DateTime?   @db.Date
  depositType          String      @default("NONE") // NONE | PERCENT | FIXED
  depositValue         Int         @default(0) // percent (0-100) or cents
  depositRequired      Boolean     @default(false) // shown as required before booking
  sentAt               DateTime?
  firstViewedAt        DateTime?
  approvedAt           DateTime?
  approvedByName       String?
  approvedIp           String?
  changesRequestedAt   DateTime?
  changeRequestMessage String?
  declinedAt           DateTime?
  declineReason        String?
  lastSentAt           DateTime? // follow-ups count from the latest send
  lastSentVia          String      @default("EMAIL") // EMAIL | SMS: follow-ups use the same channel
  convertedAt          DateTime?
  archivedAt           DateTime?
  jobId                String?     @unique
  options              Json        @default("[]") // good/better/best: [{key,name,recommended}]; empty = one plain list of lines
  chosenOption         String? // the option key the client approved
  createdAt            DateTime    @default(now())

  lineItems   QuoteLineItem[]
  attachments Attachment[]

  @@unique([businessId, number])
}

// A reusable quote: title, message, lines (JSON, same shape as QuoteLineInput), discount and deposit settings.
model QuoteTemplate {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  title           String?
  message         String?
  lines           Json     @default("[]")
  options         Json     @default("[]") // same shape as Quote.options
  discountType    String   @default("FIXED")
  discountValue   Int      @default(0)
  depositType     String   @default("NONE")
  depositValue    Int      @default(0)
  depositRequired Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([businessId, name])
}

model QuoteLineItem {
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId      String?
  name           String
  description    String?
  quantity       Decimal @default(1) @db.Decimal(9, 2)
  unitPriceCents Int
  totalCents     Int
  isOptional     Boolean @default(false)
  isSelected     Boolean @default(true)
  sortOrder      Int     @default(0)
  optionKey      String? // which option this line belongs to; null = common to every option
  photoId        String? // Attachment id: one picture shown beside the line
}

// ---------- snow ----------
model Season {
  id               String   @id @default(cuid())
  businessId       String
  name             String
  startsOn         DateTime @db.Date
  endsOn           DateTime @db.Date
  defaultTriggerCm Int      @default(2)

  events SnowEvent[]
  jobs   Job[]
}

model SnowEvent {
  id               String          @id @default(cuid())
  businessId       String
  seasonId         String
  season           Season          @relation(fields: [seasonId], references: [id])
  number           Int
  name             String
  status           SnowEventStatus @default(FORECAST)
  forecastCm       Int?
  measuredCm       Int?
  snowStartedAt    DateTime?
  snowEndedAt      DateTime?
  activatedAt      DateTime?
  completedAt      DateTime?
  pushCount        Int             @default(1)
  forecastSnapshot Json?
  notes            String?
  createdAt        DateTime        @default(now())

  visits   Visit[]
  invoices Invoice[]
}

// ---------- jobs & visits ----------
model Job {
  id                 String           @id @default(cuid())
  businessId         String
  number             Int
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id])
  requestId          String?
  request            Request?         @relation(fields: [requestId], references: [id])
  quoteId            String?
  seasonId           String?
  season             Season?          @relation(fields: [seasonId], references: [id])
  kind               JobKind
  title              String
  instructions       String?
  billingType        BillingType      @default(PER_VISIT)
  invoiceSchedule    InvoiceSchedule  @default(AFTER_EACH_VISIT)
  totalCents         Int?
  discountCents      Int              @default(0) // discount agreed on the quote this job came from: comes off its first invoice, once
  // RECURRING
  rrule              String?
  recurrenceStartsOn DateTime?        @db.Date
  recurrenceEndsOn   DateTime?        @db.Date
  asNeeded           Boolean          @default(false)
  anytime            Boolean          @default(true)
  defaultStartMinute Int?
  defaultDurationMin Int?
  defaultAssigneeIds String[]        @default([]) // who each generated visit is assigned to
  pausedFrom         DateTime?        @db.Date // no visits are generated from here...
  pausedUntil        DateTime?        @db.Date // ...to here (inclusive)
  invoiceDay         Int? // MONTHLY invoicing: day of the month (1-28); null = the 1st
  // SNOW_PLAN
  triggerCm          Int?
  snowBillingMode    SnowBillingMode?
  pricePerPushCents  Int?
  seasonalPriceCents Int?
  seasonalInstalments Int? // SEASONAL: 1 = paid in full up front, N = monthly instalments
  seasonalFirstDueOn  DateTime? @db.Date // SEASONAL: when instalment 1 is invoiced; the rest follow on the 1st of each month
  addonsIncluded      Boolean   @default(false) // SEASONAL: ice melt is covered by the season price
  iceMelt            Boolean          @default(false)
  planPausedAt       DateTime?
  sizeHoldAt         DateTime? // waiting on the client to OK a new price for a bigger driveway; no visits until then
  pendingPrice       Json? // { size, extraWalk, baseCents, walkCents } offered to the client
  depthTiers         Json? // [{ overCm, addCents }]: deeper snow adds to the per-push / per-storm price (snow/tiers.ts); null = flat price
  closedAt           DateTime?
  closeReason        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lineItems    JobLineItem[]
  visits       Visit[]
  invoices     Invoice[]
  attachments  Attachment[]
  invoiceLines InvoiceLineItem[]

  @@unique([businessId, number])
  @@index([businessId, kind, seasonId])
  // raw SQL in migration: one open snow plan per property per season
  checklistTemplateId String? // each visit gets a copy of this checklist
  requireSignature Boolean @default(false) // client signs on the phone before a visit can be marked Done
}

model JobLineItem {
  id             String  @id @default(cuid())
  jobId          String
  job            Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceId      String?
  name           String
  description    String?
  quantity       Decimal @default(1) @db.Decimal(9, 2)
  unitPriceCents Int
  totalCents     Int
  perVisit       Boolean @default(true)
  sortOrder      Int     @default(0)
}

model Visit {
  id                     String      @id @default(cuid())
  businessId             String
  jobId                  String
  job                    Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  propertyId             String
  property               Property    @relation(fields: [propertyId], references: [id])
  snowEventId            String?
  snowEvent              SnowEvent?  @relation(fields: [snowEventId], references: [id])
  pushNumber             Int?
  scheduledDate          DateTime?   @db.Date
  startAt                DateTime?
  endAt                  DateTime?
  anytime                Boolean     @default(true)
  state                  VisitState  @default(SCHEDULED)
  routeSort              Int? // set only by a "today only" reorder; null = follow the property's standing routeSort
  assigneeId             String?
  source                 VisitSource @default(MANUAL)
  recurrenceDate         DateTime?   @db.Date
  detachedFromRecurrence Boolean     @default(false)
  enRouteAt              DateTime?
  arrivedAt              DateTime?
  completedAt            DateTime?
  assignees              VisitAssignee[]
  confirmedAt            DateTime? // client tapped Confirm on the reminder
  rescheduleRequest      String? // client asked to move it (their message)
  rescheduleRequestedAt  DateTime?
  completedById          String?
  completedLat           Float?
  completedLng           Float?
  skippedAt              DateTime?
  skipReason             SkipReason?
  skipNote               String?
  depthCm                Int?
  iceMeltApplied         Boolean?
  instructions           String?
  lineOverrides          Json? // this visit only: [{ name, description?, quantity, unitPriceCents }] charged instead of the job's lines
  isReturn               Boolean     @default(false) // a return visit on the same storm (the city plough buried the driveway end)
  returnPriceCents       Int? // return visit: what it bills when done; null = included, no charge
  iceMeltBags            Decimal?    @db.Decimal(6, 2) // how much ice melt went down (the charge stays flat per visit)
  createdAt              DateTime    @default(now())

  charges      VisitCharge[]
  extras       VisitExtra[]
  attachments  Attachment[]
  invoiceLines InvoiceLineItem[]

  @@unique([jobId, snowEventId, pushNumber])
  @@unique([jobId, recurrenceDate])
  @@index([businessId, scheduledDate])
}

// Created when a visit completes; "unbilled" = invoiceLineItemId IS NULL.
// A one-off add-on for a single visit (e.g. ice melt this time), ordered from the client hub. Becomes a VisitCharge
// when the visit is completed, so it is billed once like any other charge.
model VisitExtra {
  id              String   @id @default(cuid())
  businessId      String
  visitId         String
  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  serviceKey      String // price-book key (keys never change)
  name            String
  unitPriceCents  Int // the price the client saw when they added it
  addedByClientId String?
  createdAt       DateTime @default(now())

  @@unique([visitId, serviceKey])
}

model VisitCharge {
  id                String           @id @default(cuid())
  businessId        String
  visitId           String
  visit             Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name              String
  quantity          Decimal          @default(1) @db.Decimal(9, 2)
  unitPriceCents    Int
  totalCents        Int
  invoiceLineItemId String?          @unique
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id])
  createdAt         DateTime         @default(now())
}

// ---------- billing ----------
model Invoice {
  id                      String        @id @default(cuid())
  businessId              String
  number                  Int
  clientId                String
  client                  Client        @relation(fields: [clientId], references: [id])
  propertyId              String?
  jobId                   String?
  job                     Job?          @relation(fields: [jobId], references: [id])
  snowEventId             String?
  snowEvent               SnowEvent?    @relation(fields: [snowEventId], references: [id])
  status                  InvoiceStatus @default(DRAFT)
  subject                 String?
  message                 String?
  issuedOn                DateTime?     @db.Date
  dueOn                   DateTime?     @db.Date
  paymentTerms            PaymentTerms  @default(DUE_ON_RECEIPT)
  subtotalCents           Int           @default(0)
  discountCents           Int           @default(0)
  taxCents                Int           @default(0)
  totalCents              Int           @default(0)
  amountPaidCents         Int           @default(0)
  lateFeeAppliedAt        DateTime? // the one late fee this invoice can get (Settings: late fee)
  etransferRef            String
  sentAt                  DateTime?
  firstViewedAt           DateTime?
  paidAt                  DateTime?
  voidedAt                DateTime?
  voidReason              String?
  badDebtAt               DateTime?
  remindersSent           Int           @default(0)
  lastReminderAt          DateTime?
  stripeCheckoutSessionId String?
  createdAt               DateTime      @default(now())

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([businessId, number])
  @@unique([businessId, etransferRef])
  @@unique([businessId, instalmentKey])
  instalmentKey      String? // seasonal snow plan instalment "<jobId>:<n>": never invoiced twice
  kind               InvoiceKind @default(STANDARD)
  quoteId            String? // deposit invoices: the quote they're for
  appliedToInvoiceId String? // deposit invoices: the job invoice that used this deposit up
  allowPartial       Boolean     @default(false) // client may pay part of the balance online
  autoPayState       AutoPayState? // set when sent to a client with auto-pay on; null = pay the usual way
  autoPayOn          DateTime?   @db.Date // next day the saved card is charged (first try or retry)
  autoPayAttempts    AutoPayAttempt[]
}

enum AutoPayState {
  SCHEDULED // will be charged on autoPayOn
  RETRYING // a charge failed; next try on autoPayOn
  NEEDS_ACTION // the bank wants the client to approve: they pay from the invoice page
  FAILED // every try failed: owner told, nothing more is charged
  PAID
  STOPPED // auto-pay turned off / card removed before the charge
}

enum AutoPayAttemptStatus {
  PENDING // claimed, Stripe's answer not recorded yet
  SUCCEEDED
  FAILED
  REQUIRES_ACTION
}

/// One off-session charge of a saved card for an invoice. (invoiceId, n) is unique, so an invoice can never have two
/// "first tries": the row is the claim, and its id + n make the Stripe idempotency key.
model AutoPayAttempt {
  id                    String               @id @default(cuid())
  businessId            String
  invoiceId             String
  invoice               Invoice              @relation(fields: [invoiceId], references: [id])
  clientId              String
  n                     Int
  amountCents           Int
  status                AutoPayAttemptStatus @default(PENDING)
  stripePaymentMethodId String
  cardLabel             String // "Visa •••• 4242" as it was when charged
  stripePaymentIntentId String?
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime             @default(now())
  finishedAt            DateTime?

  @@unique([invoiceId, n])
  @@index([status])
}

model InvoiceLineItem {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?         @relation(fields: [jobId], references: [id])
  visitId        String?
  visit          Visit?       @relation(fields: [visitId], references: [id])
  serviceId      String?
  name           String
  description    String?
  serviceDate    DateTime?    @db.Date
  quantity       Decimal      @default(1) @db.Decimal(9, 2)
  unitPriceCents Int
  totalCents     Int
  sortOrder      Int          @default(0)
  charge         VisitCharge?
}

model Payment {
  id                      String        @id @default(cuid())
  businessId              String
  clientId                String
  client                  Client        @relation(fields: [clientId], references: [id])
  invoiceId               String
  invoice                 Invoice       @relation(fields: [invoiceId], references: [id])
  method                  PaymentMethod
  status                  PaymentStatus @default(SUCCEEDED)
  amountCents             Int
  feeCents                Int?
  refundedCents           Int           @default(0)
  tipCents                Int? // card tip on top of amountCents: never part of the invoice balance or GST
  tipRefundedCents        Int           @default(0) // how much of the tip went back (refunds in Stripe come off the tip first)
  receivedAt              DateTime      @default(now())
  reference               String?
  note                    String?
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?
  recordedById            String?
  unmatchedPaymentId      String?
  unmatchedPayment        UnmatchedPayment? @relation(fields: [unmatchedPaymentId], references: [id])
  createdAt               DateTime      @default(now())
}

// Money that came in but couldn't be matched to an invoice automatically (e.g. an e-Transfer from a spouse's
// account with no ETC- code). Owners apply it to one or more invoices, or dismiss it.
model UnmatchedPayment {
  id              String                 @id @default(cuid())
  businessId      String
  source          String // "interac"
  method          PaymentMethod          @default(ETRANSFER)
  amountCents     Int
  sender          String?
  message         String?
  providerRef     String? // Interac reference number: never queue or apply the same transfer twice
  receivedAt      DateTime               @default(now())
  status          UnmatchedPaymentStatus @default(OPEN)
  dismissedReason String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime               @default(now())
  payments        Payment[]

  @@unique([businessId, providerRef])
  @@index([businessId, status])
}

enum UnmatchedPaymentStatus {
  OPEN
  APPLIED
  DISMISSED
}

// ---------- media, notes, audit, mail ----------
model Attachment {
  id                String         @id @default(cuid())
  businessId        String
  kind              AttachmentKind
  mediaType         MediaType      @default(IMAGE)
  storageKey        String
  contentType       String
  bytes             Int
  width             Int?
  height            Int?
  sha256            String
  capturedAt        DateTime?
  capturedLat       Float?
  capturedLng       Float?
  uploadedByType    ActorType
  uploadedById      String?
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id])
  propertyId        String?
  property          Property?      @relation(fields: [propertyId], references: [id])
  requestId         String?
  request           Request?       @relation(fields: [requestId], references: [id])
  quoteId           String?
  quote             Quote?         @relation(fields: [quoteId], references: [id])
  jobId             String?
  job               Job?           @relation(fields: [jobId], references: [id])
  visitId           String?
  visit             Visit?         @relation(fields: [visitId], references: [id])
  textMessageId     String?
  textMessage       TextMessage?   @relation(fields: [textMessageId], references: [id])
  noteId            String?
  note              Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  filename          String?
  caption           String?
  sharedWithClient  Boolean        @default(false)
  showcase          Boolean        @default(false)
  showcaseConsentAt DateTime?
  sortOrder         Int            @default(0)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())

  @@index([textMessageId])
  @@index([noteId])
}

model Note {
  id               String   @id @default(cuid())
  businessId       String
  authorId         String?
  body             String
  sharedWithClient Boolean  @default(false)
  pinned           Boolean  @default(false)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])
  propertyId       String?
  requestId        String?
  quoteId          String?
  jobId            String?
  visitId          String?
  invoiceId        String?
  linkDownstream   Boolean  @default(true) // a client note also shows on that client's requests, quotes, jobs, invoices
  editedAt         DateTime?
  attachments      Attachment[]
  createdAt        DateTime @default(now())

  @@index([businessId, clientId])
  @@index([businessId, jobId])
}

model ActivityEvent {
  id            String    @id @default(cuid())
  businessId    String
  at            DateTime  @default(now())
  actorType     ActorType
  actorUserId   String?
  actorClientId String?
  type          String // "booking.received", "visit.completed", ...
  entityType    String
  entityId      String
  clientId      String?
  jobId         String?
  snowEventId   String?
  data          Json      @default("{}")

  @@index([businessId, entityType, entityId])
  @@index([businessId, clientId])
}

model EmailMessage {
  id                String      @id @default(cuid())
  businessId        String
  template          String
  dedupeKey         String?
  to                String
  cc                String[]
  replyTo           String?
  subject           String
  props             Json
  priority          Int         @default(5) // 1 = must send (login, receipts), 9 = can wait
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now())
  sentAt            DateTime?
  lastError         String?
  providerMessageId String?
  clientId          String?
  entityType        String?
  entityId          String?
  createdAt         DateTime    @default(now())

  @@unique([businessId, dedupeKey])
  @@index([status, nextAttemptAt])
}

// The owner's own wording for a message (Settings › Messages). `template` is an email ("invoice.sent": subject, intro,
// closing) or a text ("sms.quote": body). A missing row or null field means the built-in wording.
model EmailTemplateOverride {
  businessId String
  template   String
  subject    String?
  intro      String?
  closing    String?
  body       String?
  enabled    Boolean @default(true)

  @@id([businessId, template])
}

model Counter {
  businessId String
  kind       CounterKind
  next       Int         @default(1)

  @@id([businessId, kind])
}

model WeatherSnapshot {
  id        String   @id @default(cuid())
  fetchedAt DateTime @default(now())
  payload   Json
}

// Every text in or out (two-way SMS via Telnyx). Automatic texts go through the outbox and are logged here too.
model TextMessage {
  id          String    @id @default(cuid())
  businessId  String
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  direction   TextDirection
  from        String // E.164
  to          String // E.164
  body        String
  status      String    @default("queued") // queued | sent | delivered | failed | received
  providerId  String?   @unique
  error       String?
  sentById    String?
  readAt      DateTime?
  type        String    @default("SMS") // SMS | MMS | RCS (as the carrier reported it)
  media       Attachment[]
  mediaPending Json? // inbound MMS files not downloaded yet: [{url, contentType, attempts}]
  createdAt   DateTime  @default(now())

  @@index([businessId, clientId, createdAt])
  @@index([businessId, direction, readAt])
}

enum TextDirection {
  IN
  OUT
}

/** More people on a client account: spouse, tenant, property manager. */
model ClientContact {
  id            String   @id @default(cuid())
  businessId    String
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role          String? // Spouse, Tenant, Property manager...
  firstName     String
  lastName      String   @default("")
  phone         String?
  email         String?
  isBilling     Boolean  @default(false)
  receivesTexts Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([clientId])
}

/** Phone calls: logged by hand, or pulled from Telnyx call records (providerId dedupes). */
model CallLog {
  id          String        @id @default(cuid())
  businessId  String
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  direction   TextDirection
  from        String
  to          String
  status      String        @default("answered") // answered | missed | voicemail | no_answer
  startedAt   DateTime      @default(now())
  durationSec Int?
  notes       String?
  loggedById  String?
  providerId  String?       @unique
  createdAt   DateTime      @default(now())

  @@index([businessId, clientId, startedAt])
}

model VisitAssignee {
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([visitId, userId])
  @@index([userId])
}

enum TaskKind {
  TASK // a to-do, optionally for a client/job
  EVENT // a block on the calendar (day off, supply run)
}

/** Basic tasks and calendar events. Repeating ones are materialized as a series (seriesId) up to a year out. */
model Task {
  id           String    @id @default(cuid())
  businessId   String
  kind         TaskKind  @default(TASK)
  title        String
  instructions String?
  clientId     String?
  propertyId   String?
  jobId        String?
  date         DateTime? @db.Date
  startAt      DateTime?
  endAt        DateTime?
  allDay       Boolean   @default(true)
  repeat       String? // "DAILY" | "WEEKLY" | "BIWEEKLY" | "MONTHLY" (series template)
  seriesId     String?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  assignees    TaskAssignee[]

  @@index([businessId, date])
  @@index([businessId, clientId])
  @@index([seriesId])
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/** Time on a visit or job, or on the day's general clock (no visit/job). A running timer has no endedAt; minutes is
 * filled when it stops (or for manual entries). Approved entries are locked until an owner un-approves them. */
model TimeEntry {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitId    String?
  jobId      String?
  startedAt  DateTime
  endedAt    DateTime?
  minutes    Int?
  note       String?
  approvedAt   DateTime?
  approvedById String?
  createdAt  DateTime  @default(now())

  @@index([businessId, startedAt])
  @@index([jobId])
  @@index([userId, endedAt])
}

/** Money spent on a job (salt, dump fees, gas, parts). */
model Expense {
  id           String   @id @default(cuid())
  businessId   String
  jobId        String?
  userId       String?
  date         DateTime @db.Date
  category     String   @default("Materials")
  description  String
  amountCents  Int // what was paid, GST included
  gstCents     Int      @default(0) // the GST part of amountCents (input tax credit)
  vendor       String? // where it was bought
  attachmentId String?
  createdAt    DateTime @default(now())

  @@index([businessId, date])
  @@index([jobId])
}

/** A reusable checklist. items: [{id, label, type: CHECKBOX|YESNO|TEXT|NUMBER|PHOTO, required, showClient}]. */
model ChecklistTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  items      Json     @default("[]")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/** A visit's own copy of a checklist (so editing the template never rewrites history) plus the answers. */
model VisitChecklist {
  id           String    @id @default(cuid())
  businessId   String
  visitId      String    @unique
  templateName String
  items        Json
  answers      Json      @default("{}")
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

enum SignatureKind {
  QUOTE
  VISIT
  INVOICE
}

/** A drawn signature: who, what they agreed to, a hash of the document at that moment, and where from. */
model Signature {
  id           String        @id @default(cuid())
  businessId   String
  kind         SignatureKind
  quoteId      String?
  visitId      String?
  invoiceId    String?
  attachmentId String
  signerName   String
  statement    String
  docHash      String?
  ip           String?
  userAgent    String?
  inPerson     Boolean       @default(false) // signed on the owner's phone
  signedAt     DateTime      @default(now())

  @@index([quoteId])
  @@index([visitId])
  @@index([invoiceId])
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
}

/** "How did we do?" sent after work; 4-5 stars go to Google, 1-3 to private feedback. */
model ReviewRequest {
  id              String    @id @default(cuid())
  businessId      String
  clientId        String
  jobId           String?
  channel         String // EMAIL | SMS
  sentAt          DateTime  @default(now())
  rating          Int?
  feedback        String?
  ratedAt         DateTime?
  googleClickedAt DateTime?
  followUpAt      DateTime? // the one reminder, if it was sent

  @@index([businessId, sentAt])
  @@index([clientId])
}

enum ReferralStatus {
  PENDING // referred client booked
  QUALIFIED // their first invoice is paid; referrer credit issued
  REWARDED // the credit was used on an invoice
}

model Referral {
  id          String         @id @default(cuid())
  businessId  String
  referrerId  String
  refereeId   String         @unique
  status      ReferralStatus @default(PENDING)
  rewardCents Int            @default(0)
  qualifiedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
}

/** Money owed to a client as credit (referral rewards); used up as a negative line on their next invoice. */
model ClientCredit {
  id                 String   @id @default(cuid())
  businessId         String
  clientId           String
  amountCents        Int
  reason             String
  referralId         String?
  paymentId          String? // overpayment: the payment whose excess became this credit
  appliedToInvoiceId String?
  createdAt          DateTime @default(now())

  @@index([clientId])
}

enum CampaignChannel {
  EMAIL
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/** A marketing email or text to an audience (filters as JSON). Recipients are fixed when it's sent. */
model Campaign {
  id           String          @id @default(cuid())
  businessId   String
  name         String
  channel      CampaignChannel @default(EMAIL)
  subject      String?
  blocks       Json            @default("[]") // email: [{type: heading|text|button|divider, text, url}]
  smsBody      String?
  audience     Json            @default("{}")
  status       CampaignStatus  @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())
  automation   String? // "WINBACK" | "RENEWAL": sent by the hourly scheduler, not by hand; its numbers live in `audience`
  automationOn Boolean         @default(false)
  recipients   CampaignRecipient[]

  @@unique([businessId, automation])
  @@index([businessId, createdAt])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED
  sendAfter  DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?

  @@unique([campaignId, clientId])
}

/** Days off: a person's (vacation, school) or everyone's (userId null: holiday, closed). Dates inclusive. */
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startDate])
}

/** Durable rate limiting (src/server/http.ts): one fixed window per key. Old rows are swept by the hourly scheduler. */
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

/** When each hourly automation last worked or failed (src/server/scheduler.ts), so /api/healthz shows a silently failing one. */
model AutomationRun {
  name       String    @id
  lastOkAt   DateTime?
  lastFailAt DateTime?
  lastError  String?
}
